// ============================================
//   skf-socket — WebSocket для SkyMonder
//   Сервер и Клиент
// ============================================


// --------------------------------------------
//   СЕРВЕР
// --------------------------------------------

функция создать_сервер(порт) {
    // Возвращает объект-обёртку для будущего сервера
    подключить_питон("websockets")
    подключить_питон("asyncio")
    
    пусть сервер = {
        "порт": порт,
        "обработчик_подключения": ничего,
        "обработчик_сообщения": ничего
    }
    
    вернуть сервер
}

функция при_подключении(сервер, функция_обработчик) {
    // Устанавливает обработчик для новых подключений
    сервер["обработчик_подключения"] = функция_обработчик
}

функция при_сообщении(сервер, функция_обработчик) {
    // Устанавливает обработчик для входящих сообщений
    сервер["обработчик_сообщения"] = функция_обработчик
}

async функция запустить_сервер(сервер) {
    // Запускает WebSocket-сервер и слушает порт
    подключить_питон("websockets")
    подключить_питон("asyncio")
    
    лог("🚀 Сервер запущен на порту " + сервер["порт"])
    
    // Внутренняя функция для обработки одного клиента
    async функция обработать_клиента(websocket, путь) {
        лог("✅ Новое подключение: " + путь)
        
        если (сервер["обработчик_подключения"] != ничего) {
            сервер["обработчик_подключения"](websocket)
        }
        
        попробовать {
            пока (истина) {
                пусть сообщение = await websocket.recv()
                лог("📩 Получено: " + сообщение)
                
                если (сервер["обработчик_сообщения"] != ничего) {
                    пусть ответ = сервер["обработчик_сообщения"](сообщение)
                    если (ответ != ничего) {
                        await websocket.send(ответ)
                    }
                } иначе {
                    await websocket.send("Эхо: " + сообщение)
                }
            }
        } поймать (ошибка) {
            лог("🔌 Клиент отключился")
        }
    }
    
    // Запускаем сервер
    await websockets.serve(обработать_клиента, "localhost", сервер["порт"])
    await asyncio.Future() // Бесконечное ожидание
}


// --------------------------------------------
//   КЛИЕНТ
// --------------------------------------------

функция создать_клиент(адрес) {
    // Создаёт объект-обёртку для клиента
    подключить_питон("websockets")
    подключить_питон("asyncio")
    
    пусть клиент = {
        "адрес": адрес, // Например: "ws://localhost:8080"
        "соединение": ничего,
        "обработчик_сообщения": ничего
    }
    
    вернуть клиент
}

async функция подключиться(клиент) {
    // Устанавливает соединение с сервером
    подключить_питон("websockets")
    
    клиент["соединение"] = await websockets.connect(клиент["адрес"])
    лог("🔗 Подключено к " + клиент["адрес"])
}

async функция отправить(клиент, сообщение) {
    // Отправляет сообщение на сервер
    если (клиент["соединение"] == ничего) {
        бросить "Сначала вызови подключиться()"
    }
    await клиент["соединение"].send(сообщение)
    лог("📤 Отправлено: " + сообщение)
}

async функция получить(клиент) {
    // Получает одно сообщение от сервера
    если (клиент["соединение"] == ничего) {
        бросить "Сначала вызови подключиться()"
    }
    пусть сообщение = await клиент["соединение"].recv()
    лог("📨 Получено: " + сообщение)
    вернуть сообщение
}

async функция слушать(клиент, функция_обработчик) {
    // Бесконечно слушает входящие сообщения и вызывает обработчик
    клиент["обработчик_сообщения"] = функция_обработчик
    попробовать {
        пока (истина) {
            пусть сообщение = await получить(клиент)
            клиент["обработчик_сообщения"](сообщение)
        }
    } поймать (ошибка) {
        лог("🔌 Соединение потеряно: " + ошибка)
    }
}

async функция закрыть(клиент) {
    // Закрывает соединение
    если (клиент["соединение"] != ничего) {
        await клиент["соединение"].close()
        клиент["соединение"] = ничего
        лог("🔒 Соединение закрыто")
    }
}
